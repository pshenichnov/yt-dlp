{
  "ConnectionStrings": {
    "AnalyzerDatabase": "Host=postgres;Port=5432;Database=youtube_analyzer;Username=youtube;Password=youtube_dev"
  },
  "RabbitMq": {
    "Host": "rabbitmq",
    "VirtualHost": "/",
    "Username": "youtube",
    "Password": "youtube_dev"
  },
  "Analyzer": {
    "Provider": "ollama",
    "OllamaEndpoint": "http://ollama:11434",
    "Model": "llama3.2:3b",
    "PromptVersion": "video-summary-v1",
    "MaxTranscriptCharacters": 2000000,
    "ChunkCharacterLimit": 48000,
    "Blob": {
      "Endpoint": "http://minio:9000",
      "AccessKey": "youtube",
      "SecretKey": "youtube_dev_secret",
      "Bucket": "youtube-processing",
      "Region": "us-east-1"
    }
  },
  "Database": {
    "ApplyMigrations": true
  },
  "Observability": {
    "OtlpEndpoint": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
