<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../BuildingBlocks/YouTubeProcessing.Contracts/YouTubeProcessing.Contracts.csproj" />
    <ProjectReference Include="../../BuildingBlocks/YouTubeProcessing.Observability/YouTubeProcessing.Observability.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Analysis/analysis-output-schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>analysis-output-schema.json</TargetPath>
    </Content>
    <Content Update="Analysis/summary-output-schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>summary-output-schema.json</TargetPath>
    </Content>
    <Content Update="Analysis/topics-output-schema.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>topics-output-schema.json</TargetPath>
    </Content>
  </ItemGroup>
</Project>
